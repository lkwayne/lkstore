# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp Business (Meta Cloud API) — notifications d'accès client.
# Inactif tant que ces trois variables ne sont pas renseignées (voir
# src/services/whatsapp-notification.service.ts). Nécessite un compte
# WhatsApp Business Platform validé par Meta et un template de message
# approuvé (catégorie "utility").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCOUNT_TEMPLATE_NAME=

# Réservé pour intégrations futures (ne rien mettre pour l'instant) :
# ORANGE_MONEY_API_KEY=
# MTN_MOMO_API_KEY=

# Contact (affichés sur /contact ; un canal vide n'est pas affiché)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
